        <mxCell id="own" value="&lt;b&gt;endogenous&#160;&#160;&#8477;&#8312;&lt;/b&gt;&lt;br&gt;har_daily, har_weekly, har_monthly,&lt;br&gt;mr_change, mr_slope5, mr_slope10,&lt;br&gt;mr_dev5, mr_z22" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f4ea;strokeColor=#2f7d4a;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
