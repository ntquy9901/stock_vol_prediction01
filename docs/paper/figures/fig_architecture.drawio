<mxfile host="app.diagrams.net" type="device">
  <diagram name="architecture" id="arch-v">
    <mxGraphModel dx="900" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="700" pageHeight="990" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="XGB: x&#8712;&#8477;&#8312; (own)&#160;&#160;&#183;&#160;&#160;XGB+E: &#8477;&#185;&#178; (own+E)&#160;&#160;&#183;&#160;&#160;XGB+E+LG: + leaf-graph smoothing" style="text;html=1;align=center;fontSize=13;fontStyle=2;" vertex="1" parent="1">
