        <mxCell id="xgb" value="&lt;b&gt;Gamma-loss gradient boosting (XGBoost)&lt;/b&gt;&lt;br&gt;&lt;br&gt;F(x) = &#931;&lt;sub&gt;m=1&lt;/sub&gt;&lt;sup&gt;300&lt;/sup&gt; &#951; f&lt;sub&gt;m&lt;/sub&gt;(x),&#160;&#160;f&lt;sub&gt;m&lt;/sub&gt;: regression tree&lt;br&gt;(31 leaves, &#951; = 0.05)&#160;&#160;&#183;&#160;&#160;reg:gamma loss = QLIKE + const&lt;br&gt;3-seed ensemble&#160;&#160;&#183;&#160;&#160;trained per market: S&amp;P 500 &#183; HOSE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9e9f5;strokeColor=#000000;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="150" y="390" width="400" height="140" as="geometry" />
