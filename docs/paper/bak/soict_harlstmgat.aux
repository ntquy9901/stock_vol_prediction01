\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Main study (per-observation, per-stock 80/10/10): QLIKE point estimates (lower is better; 5-seed mean; best in bold). This is a descriptive design comparison; panel-correct significance is not marked here, because the date-clustered DM verdicts are computed on the snapshot design (Table~\ref {tab:haranchor-vnsummary}, Sec.~\ref {sec:haranchor}). A naive per-observation DM on this design flags the short-horizon Vietnamese LSTM-vs-HAR gaps as significant, but overstates significance on a cross-sectionally dependent panel by a factor of order $\sqrt  {N}$ (Method).}}{5}{}\protected@file@percent }
\newlabel{tab:main}{{1}{5}{}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Graph-check (common-date snapshot, lookback 10): QLIKE (5-seed mean; best in bold) and the leave-one-out Diebold--Mariano statistic (DM$_{\mathrm  {LOO}}$) comparing LSTM+GAT with LSTM(w/o GAT) on QLIKE ($*$: $p<0.05$; a positive value favours the no-graph model). The graph never improves QLIKE.}}{5}{}\protected@file@percent }
\newlabel{tab:graph}{{2}{5}{}{table.2}{}}
