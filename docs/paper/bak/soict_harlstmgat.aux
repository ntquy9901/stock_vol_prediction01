\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces HAR-anchored ladder on the Vietnamese panels (common-date snapshot; 5-seed means): QLIKE for HAR (E0), the full-target deep models (E1 LSTM, E2 LSTM+GAT) and the convex combination (E3, the closest competitor to HAR), with the date-clustered DM $p$ of E3 vs HAR (lower QLIKE is better). No rung beats HAR at any horizon, so no significance marker ($*$, date-clustered $p<0.05$ vs HAR) appears; the full detail (E0--E10 with $R^2_{OOS}$ and per-rung DM $p$) is in Table~\ref {tab:haranchor-vndetail} (Appendix).}}{7}{}\protected@file@percent }
\newlabel{tab:haranchor-vnsummary}{{3}{7}{}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces HAR-anchored ladder on the S\&P~500 subset (457 nodes; 5-seed means, date-clustered DM $p$ vs HAR). $*$ marks a model that significantly beats HAR on QLIKE ($p<0.05$). Non-fragile rungs shown; the additive/graph residual rungs E5--E8 are numerically fragile on this cross-section and are discussed in the text.}}{8}{}\protected@file@percent }
\newlabel{tab:haranchor-sp500}{{4}{8}{}{table.4}{}}
