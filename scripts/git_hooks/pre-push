#!/usr/bin/env bash
# Pre-push quality gate — runs automatically before every `git push`.
# Enforces (blocks push on failure): pytest, Pandera data-schema.
# Reports (warns; ratchets toward 100%): diff-coverage on changed lines, ruff.
# Activate once per clone:  git config core.hooksPath scripts/git_hooks
#
# Env knobs:
#   QG_MIN_COVER   C0 line diff-coverage %% floor that BLOCKS the push (default 100)
#   QG_MIN_BRANCH  C1 branch diff-coverage %% floor that BLOCKS the push (default 95)
#   QG_SKIP=1      emergency bypass (records intent; use only when justified)
set -uo pipefail

if [ "${QG_SKIP:-0}" = "1" ]; then
  echo "[pre-push] QG_SKIP=1 set — quality gate bypassed. Justify this in your report." >&2
  exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1
MIN_COVER="${QG_MIN_COVER:-100}"     # C0 line coverage floor on changed lines
MIN_BRANCH="${QG_MIN_BRANCH:-95}"    # C1 branch coverage floor on changed lines
FAIL=0

# Main repo root (scripts/ lives here even when pushing from a feature-branch
# worktree that lacks scripts/). Resolved from the hook's own location.
HOOK_SELF="${BASH_SOURCE[0]:-$0}"
MAINROOT="$(cd "$(dirname "$HOOK_SELF")/../.." && pwd)"

# Captured gate outcomes -> a per-commit JSON the dashboard overlays (real run
# wins over hand-entry). See scripts/task_dashboard/gate_results/.
TESTS_OK=1
DIFF_PCT=""          # C0 line diff-coverage %
BRANCH_PCT=""        # C1 branch diff-coverage %
TEST_COUNT=""        # # tests passed in the changed-scope step
LESSONS_OK="na"      # data-quality + lessons-regression suite result
RUFF_STATUS="na"
STATUSF="$ROOT/.qg_gate_status"
rm -f "$STATUSF"

# Full per-push evidence log (pytest + diff-cover + ruff output) -> docs/reports/gate_logs/<sha>.txt.
# Written to disk as an audit artifact (like gate_results/<sha>.json); not auto-committed.
SHORT_SHA="$(git rev-parse --short HEAD 2>/dev/null || echo unknown)"
GATE_LOG="$MAINROOT/docs/reports/gate_logs/${SHORT_SHA}.txt"
mkdir -p "$(dirname "$GATE_LOG")" 2>/dev/null
# C-02 (review): a re-push of the same sha (e.g. after fixing a blocked run) must NOT silently erase the prior
# attempt's evidence. Keep the previous log as .prevN.txt so blocked-then-passed audit trails are preserved.
if [ -f "$GATE_LOG" ]; then
  _pn=1; while [ -f "$MAINROOT/docs/reports/gate_logs/${SHORT_SHA}.prev${_pn}.txt" ]; do _pn=$((_pn+1)); done
  cp "$GATE_LOG" "$MAINROOT/docs/reports/gate_logs/${SHORT_SHA}.prev${_pn}.txt" 2>/dev/null
fi
{ echo "# pre-push quality-gate evidence log"; echo "commit: $SHORT_SHA"; date 2>/dev/null || true; echo; } > "$GATE_LOG"
_logsec() { { echo "=== $1 ==="; cat; echo; } >> "$GATE_LOG"; }   # pipe a step's captured output into a titled log section

# --- TDD gate (step 0): implementation code must ship WITH a test change ---
# Proxy for test-first: you cannot push new implementation .py without touching a
# test. Does not prove test-was-written-first, but makes "code with no test"
# impossible without an explicit, justified bypass.
PUSH_BASE="$(git rev-parse '@{upstream}' 2>/dev/null || git merge-base HEAD master 2>/dev/null || echo master)"
ALLPY=$(git diff --name-only "$PUSH_BASE"..HEAD -- '*.py' 2>/dev/null | grep -vE '^(archive|\.agents|\.claude|_bmad|data)/' || true)
CODE_CHG=$(echo "$ALLPY" | grep -vE '(test_|/test/|conftest)' | grep -vE '^$' || true)
TEST_CHG=$(echo "$ALLPY" | grep -E '(test_|/test/)' | grep -vE '^$' || true)
echo "[pre-push] 0/4 TDD gate (code changes require a test change)"
if [ -n "$CODE_CHG" ] && [ -z "$TEST_CHG" ]; then
  echo "[pre-push] BLOCK (TDD): implementation code changed with NO accompanying test:" >&2
  echo "$CODE_CHG" | sed 's/^/    /' >&2
  echo "  -> Write a failing test first (superpowers:test-driven-development). Bypass: QG_SKIP=1 (justify)." >&2
  FAIL=1
fi

# Coverage is measured on the CHANGED lines vs what is already pushed (PUSH_BASE = @{upstream}); a direct
# master push compared to `master` would collapse to an empty diff, so we compare to the remote tip instead.
# Tests are DISCOVERED next to each changed source (its own dir's test_*.py + tests/ or test/ subdir) and
# run under the GPU venv (torch) so torch-dependent modules are actually exercised; --cov spans the changed
# dirs so diff-cover has real data for every changed line. Falls back to the pilot smoke suite when a change
# has no adjacent tests (e.g. a pure config/doc-only .py touch).
COVPY="$MAINROOT/.venv_gpu_encode/Scripts/python.exe"; [ -x "$COVPY" ] || COVPY=python
COVARGS=""; TESTPATHS=""; SEEN_DIRS=" "
for f in $ALLPY; do
  case "$f" in
    *test_*|*/test/*|*/tests/*)          # a changed TEST file -> run exactly that file (avoid globbing a big tests/ dir)
      [ -f "$f" ] && TESTPATHS="$TESTPATHS $f" ;;
    *)                                    # a changed SOURCE file -> cover its dir + run its ADJACENT tests only
      d=$(dirname "$f"); b=$(basename "$f" .py)
      case "$SEEN_DIRS" in *" $d "*) : ;; *) SEEN_DIRS="$SEEN_DIRS$d "; [ -d "$d" ] && COVARGS="$COVARGS --cov=$d" ;; esac
      # sibling test_<module>.py + a tests/ or test/ subdir -- NOT a broad test_*.py glob (which would drag in
      # unrelated / pre-existing-broken sibling tests and false-block the push).
      for tp in "$d/test_$b.py" "$d/tests" "$d/test"; do [ -e "$tp" ] && TESTPATHS="$TESTPATHS $tp"; done ;;
  esac
done

echo "[pre-push] 1/4 changed-scope tests (+branch coverage)"
COV_OK=1
if [ -n "$TESTPATHS" ]; then
  S1OUT="$(PYTHONIOENCODING=utf-8 "$COVPY" -m pytest $TESTPATHS $COVARGS --cov-branch --cov-report=xml:.qg_coverage.xml -q 2>&1)"; S1RC=$?
elif [ -n "$COVARGS" ]; then
  # F-02 (v3): SOURCE changed but NO adjacent test was discovered (and no test file changed either). Running
  # the pilot smoke suite would NOT cover the changed source -> coverage could not be verified. FAIL CLOSED
  # rather than fall through to a vacuous pass (only a genuine test-only / docs-only push may be N/A).
  echo "[pre-push] BLOCK: source .py changed with NO adjacent test (test_<module>.py or tests/) — coverage cannot be verified." >&2
  S1OUT="(blocked: source changed, no adjacent test to verify coverage)"; S1RC=1; FAIL=1; TESTS_OK=0; COV_OK=0
else
  PILOT="baselines/2026-08-08_pooled_news_gnn_ablation_baseline"
  if [ -d "$PILOT/test" ]; then TESTDIR="$PILOT/test"; COVSRC="$PILOT/code"; else TESTDIR="scripts/quality_gate"; COVSRC="scripts/quality_gate"; fi
  echo "[pre-push]   (no changed source/tests — pilot smoke suite $TESTDIR)"
  # use the GPU venv python ($COVPY), not bare `python` (system python lacks pytest -> false-block on
  # docs/notebook/config-only pushes). Fixed 2026-09-05.
  S1OUT="$(PYTHONIOENCODING=utf-8 "$COVPY" -m pytest "$TESTDIR" --cov="$COVSRC" --cov-branch --cov-report=xml:.qg_coverage.xml -q 2>&1)"; S1RC=$?
fi
echo "$S1OUT" | tail -3
echo "$S1OUT" | _logsec "1/4 changed-scope tests"
TEST_COUNT="$(echo "$S1OUT" | grep -oE '[0-9]+ passed' | grep -oE '[0-9]+' | head -1)"
if [ "$S1RC" -ne 0 ]; then
  echo "[pre-push] BLOCK: changed-scope tests failed." >&2; FAIL=1; TESTS_OK=0; COV_OK=0
fi

echo "[pre-push] 2/4 diff-coverage on changed lines (C0 line >=${MIN_COVER}%, C1 branch >=${MIN_BRANCH}%)"
BASE="$(git merge-base HEAD master 2>/dev/null || echo master)"
# --include restricts diff-cover to the files ACTUALLY being pushed (committed PUSH_BASE..HEAD, = $ALLPY).
# diff-cover otherwise diffs the whole working tree, so unrelated uncommitted edits (stray WIP files) would
# pollute the changed-line set and false-block. Empty $ALLPY (no changed .py) -> skip the coverage gate.
if [ "$COV_OK" != "1" ]; then
  echo "[pre-push] WARN: changed-scope tests failed — coverage NOT evaluated (tests already blocking)." >&2
elif [ -z "$ALLPY" ]; then
  echo "[pre-push]   diff-coverage: N/A (no changed .py in the push)"; DIFF_PCT="na"; BRANCH_PCT="na"
elif [ -z "$COVARGS" ]; then
  # F-02 policy (documented, consistent): a TEST-ONLY push (no changed SOURCE file) has no source lines to
  # gate. This is an explicit N/A, not a silent vacuous pass. The changed tests still ran + passed in step 1.
  echo "[pre-push]   diff-coverage: N/A (test-only change — no source lines to gate; tests ran in step 1)"
  DIFF_PCT="na"; BRANCH_PCT="na"
elif command -v diff-cover >/dev/null 2>&1 && [ -f .qg_coverage.xml ]; then
  DCOUT="$(diff-cover .qg_coverage.xml --compare-branch="$PUSH_BASE" --include $ALLPY --fail-under="$MIN_COVER" 2>&1)"; DCRC=$?
  echo "$DCOUT" | grep -E 'Missing lines|Coverage:|Total:' | tail -12
  echo "$DCOUT" | _logsec "2/4 C0 line diff-coverage"
  DIFF_PCT="$(echo "$DCOUT" | grep -oE 'Coverage: [0-9.]+%' | grep -oE '[0-9.]+' | head -1)"
  if [ "$DCRC" -ne 0 ]; then
    echo "[pre-push] BLOCK: C0 line diff-coverage below ${MIN_COVER}% (add tests or a justified # pragma: no cover)." >&2; FAIL=1
  fi
  BCOUT="$(diff-cover .qg_coverage.xml --compare-branch="$PUSH_BASE" --branch-coverage --include $ALLPY --fail-under="$MIN_BRANCH" 2>&1)"; BCRC=$?
  BRANCH_PCT="$(echo "$BCOUT" | grep -oE 'Coverage: [0-9.]+%' | grep -oE '[0-9.]+' | head -1)"
  echo "[pre-push]   C1 branch: ${BRANCH_PCT:-n/a}%"
  echo "$BCOUT" | _logsec "2/4 C1 branch diff-coverage"
  if [ "$BCRC" -ne 0 ]; then
    echo "[pre-push] BLOCK: C1 branch diff-coverage below ${MIN_BRANCH}%." >&2; FAIL=1
  fi
else
  # F-02: SOURCE changed but coverage could not be produced -> FAIL CLOSED (do not silently pass unverified).
  echo "[pre-push] BLOCK: source changed but coverage unavailable (diff-cover missing or no coverage.xml)." >&2; FAIL=1
fi

echo "[pre-push] 3/4 ruff on changed code"
# Use PUSH_BASE (@{upstream}) not merge-base: on a direct-to-master push the merge-base collapses to HEAD,
# which would leave $CHANGED empty and silently skip ruff (recorded "na"). PUSH_BASE = the pushed diff.
CHANGED=$(git diff --name-only "$PUSH_BASE"..HEAD -- '*.py' 2>/dev/null | grep -vE '^(archive|\.agents|\.claude|_bmad|data)/' || true)
if command -v ruff >/dev/null 2>&1 && [ -n "$CHANGED" ]; then
  # C-01 policy (review 2026-08-29): the E/W codes are WARN-only house style (the repo deliberately uses
  # semicolon-joined statements E702, long lines E501, and lambdas E731 for compact numeric code). The
  # pyflakes F codes (unused imports F401, undefined names F821, redefinitions F811, ...) are REAL bugs and
  # are FAIL-CLOSED. So "ruff" in the gate JSON is the informational full-lint status; the block is on F.
  RUFFOUT="$(ruff check $CHANGED 2>&1)"; RUFFRC=$?
  echo "$RUFFOUT" | tail -5
  echo "$RUFFOUT" | _logsec "3/4 ruff (full E/F/W — informational)"
  [ "$RUFFRC" -eq 0 ] && RUFF_STATUS="pass" || { RUFF_STATUS="fail"; echo "[pre-push] WARN: ruff E/W house-style findings (warn-only)." >&2; }
  # Fail-closed on the pyflakes F codes that are REAL bugs. F541 (f-string without placeholders) is cosmetic
  # (a harmless redundant f-prefix), so it is excluded from the block and stays warn-only via the full lint.
  RUFFF="$(ruff check --select F --ignore F541 $CHANGED 2>&1)"; RUFFFRC=$?
  echo "$RUFFF" | _logsec "3/4 ruff --select F (real bugs, excl. cosmetic F541 — fail-closed)"
  if [ "$RUFFFRC" -ne 0 ]; then
    echo "$RUFFF" | tail -6
    echo "[pre-push] BLOCK: ruff pyflakes (F) findings — real bugs (unused import / undefined name / redefinition)." >&2; FAIL=1
  fi
else
  echo "[pre-push]   (no changed .py or ruff absent — skipped)"
fi

echo "[pre-push] 4/4 data-quality: tests (every push) + Pandera/Evidently (if data touched)"
# Data-quality test scripts run on EVERY push (cheap ~2s; enforces regardless of branch/base, since
# on a master push the merge-base collapses to HEAD and a diff-gated check would silently no-op).
DQ=""
for t in tests/test_raw_prices_quality.py tests/test_processed_data_quality.py tests/test_lessons_regression.py \
         scripts/quality_gate/test_overfit_check.py scripts/quality_gate/test_check_overfit_evidence.py; do
  [ -f "$MAINROOT/$t" ] && DQ="$DQ $MAINROOT/$t"
done
if [ -n "$DQ" ]; then
  echo "[pre-push]   data-quality (raw+processed) + lessons-learned regression tests"
  DQOUT="$("$COVPY" -m pytest $DQ -q 2>&1)"; DQRC=$?
  echo "$DQOUT" | tail -2
  echo "$DQOUT" | _logsec "4/4 data-quality + lessons-regression"
  if [ "$DQRC" -eq 0 ]; then LESSONS_OK="pass"; else LESSONS_OK="fail"; echo "[pre-push] BLOCK: data-quality/lessons tests failed." >&2; FAIL=1; fi
else
  echo "[pre-push]   data-quality tests not found on this branch (skipped)"
fi
# Over/under-fit evidence gate (user mandate 2026-08-29): any masked-rich result.json in THIS push must
# carry train/val/test metrics + a per-model 'ok' fit verdict (no over/under-fit). Only checks result.json
# actually being pushed; pre-existing (test-only) results are not in the diff and are not retro-checked.
RESULTS_CHG=$(git diff --name-only "$PUSH_BASE"..HEAD -- '*result.json' 2>/dev/null | grep -E 'masked_rich' || true)
if [ -n "$RESULTS_CHG" ]; then
  echo "[pre-push]   over/under-fit evidence gate on $(echo "$RESULTS_CHG" | wc -l | tr -d ' ') changed result.json"
  RCHG_ABS=""; for r in $RESULTS_CHG; do RCHG_ABS="$RCHG_ABS $MAINROOT/$r"; done
  OFOUT="$(python "$MAINROOT/scripts/quality_gate/check_overfit_evidence.py" $RCHG_ABS 2>&1)"; OFRC=$?
  echo "$OFOUT" | tail -8
  echo "$OFOUT" | _logsec "4/4 over-under-fit evidence gate"
  if [ "$OFRC" -ne 0 ]; then echo "[pre-push] BLOCK: result.json missing fit evidence or over/under-fit." >&2; FAIL=1; fi
fi

DATA_TOUCHED=$(git diff --name-only "$BASE"...HEAD 2>/dev/null | grep -iE 'data|manifest|scaling|dataset|panel' || true)
if [ -n "$DATA_TOUCHED" ]; then
  # scripts/quality_gate lives in the MAIN repo root (not in feature-branch
  # worktrees), so resolve it from the hook's own absolute location (MAINROOT).
  MAINROOT="$MAINROOT" QG_STATUSF="$STATUSF" python - <<'PY' || { echo "[pre-push] BLOCK: Pandera schema failed." >&2; FAIL=1; }
import os, sys, pathlib
sys.path.insert(0, os.environ.get("MAINROOT", str(pathlib.Path.cwd())))
try:
    from scripts.quality_gate.run_quality_gate import check_schema, check_drift, PROJECT_ROOT
except Exception as e:
    print(f"[pre-push] data-quality gate unavailable: {e}"); sys.exit(0)
s = check_schema(); print(f"[pre-push]   Pandera SCHEMA: {s.status}: {s.detail}")
import datetime
out = PROJECT_ROOT / "results" / "quality_gate" / ("prepush_" + datetime.datetime.now().strftime("%Y%m%d_%H%M%S"))
d = check_drift(out); print(f"[pre-push]   Evidently DRIFT: {d.status}: {d.detail}")
sf = os.environ.get("QG_STATUSF")
if sf:
    pathlib.Path(sf).write_text(f"{s.status}\n{d.status}\n", encoding="utf-8")
sys.exit(0 if s.status != "FAIL" else 3)
PY
else
  echo "[pre-push]   Pandera/Evidently: N/A (no data/manifest change)"
fi

# Delivered-baseline tests run on EVERY push using the GPU venv (torch), since the fallback pytest
# above runs system python which lacks torch. This gates the shipped volatility model's own tests
# (config-coverage guard, batching, ablation rungs, DM) that the generic step cannot execute.
echo "[pre-push] 5/5 delivered-baseline tests (volatility + feature guards, GPU venv)"
GPUPY="$MAINROOT/.venv_gpu_encode/Scripts/python.exe"
BDIRS=""
for d in baselines/2026-08-15_volatility/test baselines/2026-08-11_eda_gnn_baseline/test; do
  [ -d "$MAINROOT/$d" ] && BDIRS="$BDIRS $MAINROOT/$d"
done
if [ -x "$GPUPY" ] && [ -n "$BDIRS" ]; then
  S5OUT="$(PYTHONIOENCODING=utf-8 "$GPUPY" -m pytest $BDIRS -q 2>&1)"; S5RC=$?
  echo "$S5OUT" | tail -2
  echo "$S5OUT" | _logsec "5/5 delivered-baseline tests"
  if [ "$S5RC" -ne 0 ]; then
    echo "[pre-push] BLOCK: delivered-baseline tests failed." >&2; FAIL=1
  fi
else
  echo "[pre-push]   (GPU venv or baseline test dirs absent — skipped)"
fi

# --- Single-source-of-truth config: flag NEW hardcoded tunable constants in changed pipeline files ---
# Enforces CLAUDE.md "Single-source-of-truth app config (ENFORCED)". Heuristic, low-FP: scans only the
# ADDED lines of the push diff; BLOCKs a clear tunable (.rolling(<int>), top_k=<int>, window/floor/
# hyperparameter NAME=<literal>); WARNs a bare 1e-N. The scanner excludes the config module itself,
# tests, archive/, vendored. Bypass with QG_SKIP=1 (justify) if a flagged literal is a genuine one-off.
echo "[pre-push] 6/6 config-hardcode scan (single-source-of-truth)"
if command -v python >/dev/null 2>&1 && [ -f "$MAINROOT/scripts/quality_gate/check_config_hardcode.py" ] && [ -n "$CHANGED" ]; then
  CHOUT="$(python "$MAINROOT/scripts/quality_gate/check_config_hardcode.py" --base "$PUSH_BASE" $CHANGED 2>&1)"; CHRC=$?
  echo "$CHOUT" | tail -8
  echo "$CHOUT" | _logsec "6/6 config-hardcode scan"
  if [ "$CHRC" -ne 0 ]; then
    echo "[pre-push] BLOCK: new hardcoded tunable constant(s) in changed pipeline files — move to the canonical pipeline_config (or justify with # config-ok / QG_SKIP)." >&2; FAIL=1
  fi
else
  echo "[pre-push]   (no changed .py or scanner absent — skipped)"
fi

# --- Emit per-commit gate result JSON the dashboard overlays (real run wins) ---
BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)"
GATE_DIR="$MAINROOT/scripts/task_dashboard/gate_results"
QG_COMMIT="$SHORT_SHA" QG_BRANCH="$BRANCH" QG_TESTS="$TESTS_OK" QG_DIFF="$DIFF_PCT" QG_BRANCH_PCT="$BRANCH_PCT" \
QG_TEST_COUNT="$TEST_COUNT" QG_LESSONS="$LESSONS_OK" QG_LOG="$GATE_LOG" \
QG_RUFF="$RUFF_STATUS" QG_STATUSF="$STATUSF" QG_GATEDIR="$GATE_DIR" QG_FAIL="$FAIL" \
python - <<'PY' || echo "[pre-push] WARN: could not write gate-result JSON." >&2
import os, json, datetime, pathlib
gate_dir = pathlib.Path(os.environ["QG_GATEDIR"]); gate_dir.mkdir(parents=True, exist_ok=True)
pandera, evid = "na", "na"
sf = os.environ.get("QG_STATUSF")
if sf and os.path.exists(sf):
    lines = pathlib.Path(sf).read_text(encoding="utf-8").splitlines()
    if lines:
        pandera = "pass" if lines[0] == "PASS" else ("fail" if lines[0] == "FAIL" else "na")
    if len(lines) > 1:
        evid = lines[1].lower()
def _num(k):
    v = os.environ.get(k) or ""
    try:
        return float(v)
    except ValueError:
        return None
log = os.environ.get("QG_LOG") or ""
payload = {
    "commit": os.environ["QG_COMMIT"],
    "branch": os.environ.get("QG_BRANCH"),
    "timestamp": datetime.datetime.now().strftime("%Y-%m-%dT%H:%M:%S"),
    "tests_passed": os.environ.get("QG_TESTS") == "1",
    "test_count": int(_num("QG_TEST_COUNT")) if _num("QG_TEST_COUNT") is not None else None,
    "cov_c0_line_pct": _num("QG_DIFF"),          # C0 line diff-coverage
    "cov_c1_branch_pct": _num("QG_BRANCH_PCT"),  # C1 branch diff-coverage
    "diff_cover_pct": _num("QG_DIFF"),           # kept for dashboard back-compat (== C0)
    "ruff": os.environ.get("QG_RUFF", "na"),
    "lessons_regression": os.environ.get("QG_LESSONS", "na"),
    "pandera": pandera,
    "evidently": evid,
    "evidence_log": os.path.relpath(log, os.environ["QG_GATEDIR"] + "/../../..") if log else None,
    "overall": "fail" if os.environ.get("QG_FAIL", "0") != "0" else "pass",
}
(gate_dir / (payload["commit"] + ".json")).write_text(json.dumps(payload, indent=2), encoding="utf-8")
print(f"[pre-push] wrote gate result {gate_dir / (payload['commit'] + '.json')}")
PY

# --- 7/7 FINAL: verify the gate checklist evidence is complete (blocks if a check went unrecorded or an
# overall-pass hides a failed check) -- proves the gate actually checked everything, per user 2026-09-05 ---
echo "[pre-push] 7/7 gate-checklist completeness"
CKPY="$MAINROOT/scripts/quality_gate/gate_checklist.py"
if [ -f "$CKPY" ] && command -v python >/dev/null 2>&1; then
  CKOUT="$(python "$CKPY" "$GATE_DIR/$SHORT_SHA.json" 2>&1)"; CKRC=$?
  echo "$CKOUT"
  echo "$CKOUT" | _logsec "7/7 gate-checklist completeness"
  if [ "$CKRC" -ne 0 ]; then echo "[pre-push] BLOCK: gate checklist evidence incomplete/inconsistent." >&2; FAIL=1; fi
else
  echo "[pre-push]   (gate_checklist.py or python absent -- skipped)"
fi

# append the final verdict to the evidence log, then keep it (do NOT delete -- it is the audit artifact)
{ echo "=== VERDICT ==="; echo "overall: $([ "$FAIL" -ne 0 ] && echo FAIL || echo PASS)"; \
  echo "test_count=$TEST_COUNT C0=$DIFF_PCT C1=$BRANCH_PCT ruff=$RUFF_STATUS lessons=$LESSONS_OK"; } >> "$GATE_LOG"
echo "[pre-push] wrote evidence log $GATE_LOG"
rm -f .qg_coverage.xml "$STATUSF"
if [ "$FAIL" -ne 0 ]; then
  echo "[pre-push] QUALITY GATE FAILED — push blocked. Fix, or QG_SKIP=1 with justification." >&2
  exit 1
fi
echo "[pre-push] quality gate passed."
exit 0
